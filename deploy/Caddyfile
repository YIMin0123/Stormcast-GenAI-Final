# 放在伺服器的 /etc/caddy/Caddyfile。
# Caddy 自動申請 https 憑證（需要對外開 80、443），同一個網址做兩件事：
#   WebSocket 連線（遊戲）→ 轉給只聽本機的遊戲伺服器
#   其他（網頁、模型、音效）→ 直接送 /var/www/stormcast 裡打包好的網頁
# 換掉 sslip.io 時，同步修改站點網域、connect-src、src/net.js 的 PROD_SERVER 與 stormcast.service 的 ORIGINS。
{
	servers {
		timeouts {
			read_header 5s
			idle 45s
		}
		max_header_size 16KB
	}
}

35-229-248-193.sslip.io {
	encode zstd gzip
	header Content-Security-Policy "connect-src 'self' blob: data: wss://35-229-248-193.sslip.io"
	@admin path /admin /admin/*
	handle @admin {
		respond 404
	}
	@ws {
		path /
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @ws {
		reverse_proxy 127.0.0.1:8787
	}
	@status {
		path /status
		header !Upgrade
	}
	handle @status {
		rewrite * /
		reverse_proxy 127.0.0.1:8787
	}
	handle {
		root * /var/www/stormcast
		file_server
	}
}
