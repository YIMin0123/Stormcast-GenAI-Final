# 放在伺服器的 /etc/systemd/system/stormcast.service：開機自動啟動、當掉自動重開。
[Unit]
Description=Stormcast multiplayer server
After=network.target

[Service]
Type=simple
User=stormcast
WorkingDirectory=/opt/stormcast/server
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=3
Environment=PORT=8787
Environment=HOST=127.0.0.1
# 只接受正式網站的瀏覽器連線
Environment=ORIGINS=https://35-229-248-193.sslip.io
# 今日紀錄存在這裡
Environment=DATA_DIR=/var/lib/stormcast
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/stormcast
StateDirectory=stormcast
StateDirectoryMode=0700
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
# 跟瓦爾海姆共用一台：記憶體給個上限，出事也不會拖垮整台
MemoryMax=400M

[Install]
WantedBy=multi-user.target
